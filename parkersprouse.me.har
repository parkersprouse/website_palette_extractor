            "size": 101603,
            "text": "<!--!\n  Icons used:\n  ===============\n  * Devicon ~ https://devicon.dev ~ Copyright 2015 konpa ~ MIT License <https://github.com/devicons/devicon/blob/master/LICENSE>\n  * Octicons ~ https://primer.style/foundations/icons ~ Copyright 2024 GitHub, Inc. ~ MIT License <https://github.com/devicons/devicon/blob/master/LICENSE>\n  * Official Hanami Logo ~ https://hanamirb.org/community/ ~ Copyright Luca Guidi\n!-->\n<!DOCTYPE html>\n<html lang='en'>\n  <head>\n    <meta charset='utf-8'>\n    <meta http-equiv='X-UA-Compatible' content='IE=edge'>\n    <meta name='description' content='Parker Sprouse is a software developer from New Orleans, LA'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <meta name='msapplication-TileColor' content='#2e3440'>\n    <meta name='theme-color' content='#2e3440'>\n    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png'>\n    <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png'>\n    <link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png'>\n    <link rel='manifest' href='/site.webmanifest'>\n    <link rel='mask-icon' href='/safari-pinned-tab.svg' color='#2e3440'>\n    <title>Parker Sprouse</title>\n    <script type=\"module\" crossorigin src=\"/index-DgRuIAmg.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/index-yuSfdUTd.css\">\n  </head>\n\n  <body>\n\n    <div class='page-container'>\n      <h1 class='title'>\n        Hi, I'm Parker.\n      </h1>\n\n      <h2 class='subtitle'>\n        I'm a software developer from New Orleans, LA.\n      </h2>\n\n      <div class='synopsis'>\n        <p>I started learning to code when I was 15 (in 2008), graduated with a degree in Computer Science, and have been developing software professionally since 2016.</p>\n        <p>Most of the work I do is full-stack web development with a specialization on the front-end.</p>\n        <p>I also like to play with game development in my free time.</p>\n      </div>\n\n      <div class='flex-container'>\n        <div class='list-container'>\n          <span class='header'>Languages & Frameworks</span>\n\n          <ul class='blank-list'>\n            <li>\n              <a class='with-icon' href='https://developer.mozilla.org/en-US/docs/web/javascript/' target='_blank' rel='noopener noreferrer' referrerpolicy='no-referrer'>\n                <!-- Devicon -->\n                <svg viewBox='0 0 128 128'>\n                  <path fill='currentColor' d='M2 1v125h125V1H2zm66.119 106.513c-1.845 3.749-5.367 6.212-9.448 7.401-6.271 1.44-12.269.619-16.731-2.059-2.986-1.832-5.318-4.652-6.901-7.901l9.52-5.83c.083.035.333.487.667 1.071 1.214 2.034 2.261 3.474 4.319 4.485 2.022.69 6.461 1.131 8.175-2.427 1.047-1.81.714-7.628.714-14.065C58.433 78.073 58.48 68 58.48 58h11.709c0 11 .06 21.418 0 32.152.025 6.58.596 12.446-2.07 17.361zm48.574-3.308c-4.07 13.922-26.762 14.374-35.83 5.176-1.916-2.165-3.117-3.296-4.26-5.795 4.819-2.772 4.819-2.772 9.508-5.485 2.547 3.915 4.902 6.068 9.139 6.949 5.748.702 11.531-1.273 10.234-7.378-1.333-4.986-11.77-6.199-18.873-11.531-7.211-4.843-8.901-16.611-2.975-23.335 1.975-2.487 5.343-4.343 8.877-5.235l3.688-.477c7.081-.143 11.507 1.727 14.756 5.355.904.916 1.642 1.904 3.022 4.045-3.772 2.404-3.76 2.381-9.163 5.879-1.154-2.486-3.069-4.046-5.093-4.724-3.142-.952-7.104.083-7.926 3.403-.285 1.023-.226 1.975.227 3.665 1.273 2.903 5.545 4.165 9.377 5.926 11.031 4.474 14.756 9.271 15.672 14.981.882 4.916-.213 8.105-.38 8.581z' />\n                </svg>\n                JavaScript\n              </a>\n              <ul class='blank-list'>\n                <li>\n                  <a class='with-icon' href='https://vuejs.org/' target='_blank' rel='noopener noreferrer' referrerpolicy='no-referrer'>\n                    <!-- Devicon -->\n                    <svg class='duotone' viewBox='0 0 128 128'>\n                      <path fill='none' d='M0 8.934l49.854.158 14.167 24.47 14.432-24.47L